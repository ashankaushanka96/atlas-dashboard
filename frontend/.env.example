# API Configuration
# Set the API backend host (IP address or domain)
VITE_API_BACKEND_HOST=127.0.0.1

# Section Visibility Control
# Set to 'true' to enable, 'false' to disable each section
# These control which sections appear in the navigation bar
VITE_ENABLE_COMPONENT_DB=true
VITE_ENABLE_COMPONENT_WATCHER=true
VITE_ENABLE_COMPONENT_MAP=true
VITE_ENABLE_EC2_SCHEDULES=true
VITE_ENABLE_INFRASTRUCTURE_DETAILS=true
VITE_ENABLE_ROUTE53_STATUS=true
VITE_ENABLE_SERVER_HANDLER=true
